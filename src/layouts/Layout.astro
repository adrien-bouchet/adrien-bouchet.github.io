---
const { title = 'Adrien Bouchet' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/chat/', label: 'Chat' },
];

const videoSrc = '/dassault.jpg';
const isImageBackground = /\.(jpg|jpeg|png|webp|avif|gif)$/i.test(videoSrc);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-root">
      <div class="video-bg" aria-hidden="true">
        {isImageBackground ? (
          <img src={videoSrc} alt="" />
        ) : (
          <video autoplay muted loop playsinline>
            <source src={videoSrc} type="video/mp4" />
          </video>
        )}
      </div>
      <div class="background" aria-hidden="true"></div>
      <div class="readability" aria-hidden="true"></div>

      <header>
        <nav aria-label="Main navigation">
          <div class="internal-links">
            {navItems.map((item) => {
              const isActive = item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);

              return (
                <a href={item.href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })}
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --black: #0a0a0a;
    --white: #fff;
    --text: rgba(255, 255, 255, 0.9);
    --muted: rgba(255, 255, 255, 0.5);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    overflow: hidden;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--black);
    color: var(--text);
    font-family:
      "IBM Plex Mono", "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular,
      "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: 16px;
    line-height: 1.6;
    text-align: left;
  }

  a {
    color: inherit;
  }

  .page-root {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    overflow: hidden;
  }

  .video-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .video-bg img,
  .video-bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.75);
  }

  .video-bg img {
    display: block;
  }

  .background {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: transparent;
    filter: none;
  }

  .readability {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: transparent;
    box-shadow: inset 0 0 100px 50px rgba(0, 0, 0, 0.5);
  }

  header {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 100;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
  }

  .internal-links {
    display: flex;
    gap: 2rem;
  }

  nav a {
    display: inline-block;
    padding: 0;
    border: 0;
    color: var(--white);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: lowercase;
    transition: opacity 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  nav a:hover {
    opacity: 0.7;
  }

  nav a.active {
    border-bottom: 1px solid var(--white);
    font-weight: 700;
  }

  main {
    position: relative;
    z-index: 10;
    height: 100vh;
    width: 100vw;
    padding: 0;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  .section-title {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-content {
    color: var(--text);
    font-size: 0.88rem;
    line-height: 1.85;
    text-shadow:
      0 1px 12px rgba(0, 0, 0, 0.75),
      0 0 32px rgba(0, 0, 0, 0.35);
  }

  .section-content p {
    margin: 0 0 1.25rem;
  }

  .section-content p:last-child {
    margin-bottom: 0;
  }

  .page-section {
    position: absolute;
    top: 6.5rem;
    left: max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));
    width: min(28rem, calc(100vw - 3rem));
    max-width: 28rem;
    margin: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.75rem;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .info-label {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .info-value {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
  }

  .info-value a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .home-intro,
    .about-bio {
      margin-left: 4%;
    }

    .home-note,
    .about-current {
      margin-right: 4%;
    }

    .about-contact {
      margin-left: 8%;
    }
  }

  @media (max-width: 720px) {
    body {
      font-size: 14px;
    }

    header {
      padding: 1rem;
    }

    .internal-links {
      gap: 1rem;
    }

    nav a {
      font-size: 0.75rem;
    }

    .page-section {
      top: 5.5rem;
      left: 1.25rem;
      width: calc(100vw - 2.5rem);
      max-width: none;
    }

    .info-grid {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .info-label {
      margin-top: 1rem;
    }

    .info-label:first-child {
      margin-top: 0;
    }
  }
</style>
