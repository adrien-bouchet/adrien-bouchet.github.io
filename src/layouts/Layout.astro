---
const { title = 'Adrien Bouchet' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/chat/', label: 'Chat' },
];

const socialItems = [
  {
    href: 'https://github.com/adrien-bouchet',
    label: 'GitHub',
    icon: 'github',
  },
  {
    href: 'https://linkedin.com/in/adrien-bouchet',
    label: 'LinkedIn',
    icon: 'linkedin',
  },
];

const videoSrc = '/dassault.jpg';
const isImageBackground = /\.(jpg|jpeg|png|webp|avif|gif)$/i.test(videoSrc);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-root">
      <div class="video-bg" aria-hidden="true">
        {isImageBackground ? (
          <img src={videoSrc} alt="" />
        ) : (
          <video autoplay muted loop playsinline>
            <source src={videoSrc} type="video/mp4" />
          </video>
        )}
      </div>
      <div class="background" aria-hidden="true"></div>
      <div class="readability" aria-hidden="true"></div>

      <header>
        <nav aria-label="Main navigation">
          <div class="internal-links">
            {navItems.map((item) => {
              const isActive = item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);

              return (
                <a href={item.href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })}
          </div>
          <div class="social-links">
            {socialItems.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} title={item.label}>
                {item.icon === 'github' ? (
                  <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
                    <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                    <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                  </svg>
                )}
              </a>
            ))}
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --black: #0a0a0a;
    --white: #fff;
    --text: rgba(255, 255, 255, 0.9);
    --muted: rgba(255, 255, 255, 0.5);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    overflow: hidden;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--black);
    color: var(--text);
    font-family:
      "IBM Plex Mono", "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular,
      "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: 16px;
    line-height: 1.6;
    text-align: left;
  }

  a {
    color: inherit;
  }

  .page-root {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    overflow: hidden;
  }

  .video-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .video-bg img,
  .video-bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.75);
  }

  .video-bg img {
    display: block;
  }

  .background {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: transparent;
    filter: none;
  }

  .readability {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: transparent;
    box-shadow: inset 0 0 100px 50px rgba(0, 0, 0, 0.5);
  }

  header {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 100;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
  }

  .internal-links {
    display: flex;
    gap: 2rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  nav a {
    display: inline-block;
    padding: 0;
    border: 0;
    color: var(--white);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: lowercase;
    transition: opacity 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  nav a:hover {
    opacity: 0.7;
  }

  nav a.active {
    border-bottom: 1px solid var(--white);
    font-weight: 700;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
  }

  .social-links svg {
    display: block;
  }

  main {
    position: relative;
    z-index: 10;
    height: 100vh;
    width: 100vw;
    padding: 0;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  .section-title {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-content {
    color: var(--text);
    font-size: 0.88rem;
    line-height: 1.85;
    text-shadow:
      0 1px 12px rgba(0, 0, 0, 0.75),
      0 0 32px rgba(0, 0, 0, 0.35);
  }

  .section-content p {
    margin: 0 0 1.25rem;
  }

  .section-content p:last-child {
    margin-bottom: 0;
  }

  .page-section {
    position: absolute;
    top: 6.5rem;
    left: max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));
    width: min(28rem, calc(100vw - 3rem));
    max-width: 28rem;
    margin: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.75rem;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .info-label {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .info-value {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
  }

  .info-value a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .home-intro,
    .about-bio {
      margin-left: 4%;
    }

    .home-note,
    .about-current {
      margin-right: 4%;
    }

    .about-contact {
      margin-left: 8%;
    }
  }

  @media (max-width: 720px) {
    body {
      font-size: 14px;
    }

    header {
      padding: 1rem;
    }

    .internal-links {
      gap: 1rem;
    }

    nav a {
      font-size: 0.75rem;
    }

    .page-section {
      top: 5.5rem;
      left: 1.25rem;
      width: calc(100vw - 2.5rem);
      max-width: none;
    }

    .info-grid {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .info-label {
      margin-top: 1rem;
    }

    .info-label:first-child {
      margin-top: 0;
    }
  }
</style>
