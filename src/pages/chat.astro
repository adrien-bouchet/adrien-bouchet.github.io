---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Chat">
  <section class="chat-page" aria-label="Chat interface">
    <div id="loadingOverlay" class="loading-overlay">
      <div class="loading-content">
        <div id="loadingText" class="loading-text">Loading model...</div>
        <div id="loadingPercent" class="loading-percent">0%</div>
      </div>
    </div>

    <div class="chat-panel" id="chatPanel" style="opacity: 0; visibility: hidden;">
      <div id="modelStatus" class="model-status">Model: not loaded</div>
      <pre id="modelError" class="model-error" style="display:none; white-space:pre-wrap; max-height:6rem; overflow:auto; background:rgba(0,0,0,0.6); color:#fff; padding:0.6rem; border-radius:0.5rem;"></pre>
      <div class="model-progress" id="modelProgress" aria-hidden="true">
        <div class="model-progress-bar" id="modelProgressBar" style="width:0%"></div>
      </div>
      <button type="button" id="clearChatBtn" class="clear-chat-btn" aria-label="Clear conversation">Clear Chat</button>
      <div class="chat-log" id="chatLog" aria-live="polite"></div>

      <form class="chat-form" id="chatForm">
        <label for="chatInput" class="sr-only">Message</label>
        <textarea
          id="chatInput"
          name="message"
          rows="2"
          placeholder="Write a message..."
          required
        ></textarea>
        <button type="submit" class="sr-only">Send</button>
      </form>
    </div>
  </section>

  <script type="module">
    const form = document.getElementById('chatForm');
    const input = document.getElementById('chatInput');
    const log = document.getElementById('chatLog');
    const modelStatus = document.getElementById('modelStatus');
    const loadingOverlay = document.getElementById('loadingOverlay');
    const loadingText = document.getElementById('loadingText');
    const loadingPercent = document.getElementById('loadingPercent');
    const chatPanel = document.getElementById('chatPanel');

    let engine = null;
    let activeGenerationId = 0;
    let currentGenerationId = null;
    let pendingGeneration = null;
    let isProcessingGeneration = false;
    let backgroundSwitched = false;
    let conversationHistory = [];
    const modelProfiles = {
      compact: {
        id: 'Llama-3.2-1B-Instruct-q4f16_1-MLC',
        label: 'compact',
      },
      standard: {
        id: 'Llama-3.2-3B-Instruct-q4f16_1-MLC',
        label: 'standard',
      },
    };
    let selectedModelProfile = chooseInitialModelProfile();
    const MAX_HISTORY = 10;

    function chooseInitialModelProfile() {
      const memory = Number(navigator.deviceMemory) || 4;
      const cores = navigator.hardwareConcurrency || 4;
      const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      const prefersCompactPointer = window.matchMedia?.('(pointer: coarse)').matches;

      if (!('gpu' in navigator) || isMobile || prefersCompactPointer || memory <= 4 || cores <= 4) {
        return modelProfiles.compact;
      }

      return modelProfiles.standard;
    }

    function getModelCandidates() {
      if (selectedModelProfile.id === modelProfiles.compact.id) {
        return [modelProfiles.compact];
      }

      return [modelProfiles.standard, modelProfiles.compact];
    }

    function updateLoadingModelText(profile, isFallback = false) {
      const prefix = isFallback ? 'Retrying with' : 'Loading';
      const message = `${prefix} ${profile.label} model...`;
      loadingText.textContent = message;
      modelStatus.textContent = message;
    }

    function addMessage(role, text) {
      const item = document.createElement('div');
      item.className = `chat-message ${role}`;
      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble';
      bubble.textContent = text;
      item.appendChild(bubble);
      log.appendChild(item);
      log.scrollTop = log.scrollHeight;
      return bubble;
    }

    async function ensureEngine() {
      if (engine) return engine;
      updateLoadingModelText(selectedModelProfile);
      document.getElementById('modelProgress').style.display = 'block';

      const setProgress = (p) => {
        const pct = Math.round(p * 100);
        loadingPercent.textContent = `${pct}%`;
        
        // Calculate background darkness: 0-50% = 0 to 1, 50-100% = 1 to 0
        let backgroundOpacity;
        if (pct <= 50) {
          backgroundOpacity = pct / 50;
        } else {
          backgroundOpacity = 1 - ((pct - 50) / 50);
        }
        
        loadingOverlay.style.backgroundColor = `rgba(0, 0, 0, ${backgroundOpacity})`;
        
        // Switch background image at 50%
        if (pct >= 50 && !backgroundSwitched) {
          backgroundSwitched = true;
          const bgImg = document.querySelector('.video-bg img');
          if (bgImg) {
            bgImg.src = '/background.jpg';
          }
        }
        
        const bar = document.getElementById('modelProgressBar');
        if (bar) bar.style.width = `${pct}%`;
      };

      try {
        // Try CDN import first (works without bundler in many environments)
        let mod = null;
        try {
          console.debug('Attempting CDN import https://esm.run/@mlc-ai/web-llm');
          mod = await import('https://esm.run/@mlc-ai/web-llm');
          console.debug('CDN import succeeded');
        } catch (cdnErr) {
          console.warn('CDN import failed, falling back to package import', cdnErr);
          try {
            mod = await import('@mlc-ai/web-llm');
            console.debug('Package import succeeded');
          } catch (pkgErr) {
            console.error('Package import also failed', pkgErr);
            throw new Error('Both CDN and package imports failed: ' + pkgErr.message + ' | ' + cdnErr.message);
          }
        }

        console.debug('Imported module keys:', Object.keys(mod));
        const CreateMLCEngine = mod.CreateMLCEngine || mod.createMLCEngine || mod.default?.CreateMLCEngine || mod.default;

        if (!CreateMLCEngine) {
          throw new Error('CreateMLCEngine export not found on @mlc-ai/web-llm module');
        }

        const candidates = getModelCandidates();
        let lastError = null;

        for (const [index, profile] of candidates.entries()) {
          try {
            updateLoadingModelText(profile, index > 0);
            if (index > 0) setProgress(0);

            engine = await CreateMLCEngine(profile.id, {
              initProgressCallback: (p) => setProgress(p.progress || 0)
            });
            selectedModelProfile = profile;
            break;
          } catch (modelErr) {
            lastError = modelErr;
            console.warn(`Model init failed for ${profile.id}`, modelErr);
          }
        }

        if (!engine) {
          throw lastError || new Error('No model could be initialized');
        }

        setProgress(1);
        modelStatus.textContent = `Model loaded: ${selectedModelProfile.label}`;
        modelStatus.style.display = 'none';
        
        // Hide loading overlay and show chat panel
        loadingOverlay.style.transition = 'opacity 0.5s ease-out';
        loadingOverlay.style.opacity = '0';
        setTimeout(() => {
          loadingOverlay.style.visibility = 'hidden';
          chatPanel.style.opacity = '1';
          chatPanel.style.visibility = 'visible';
        }, 500);
        
        // hide progress after short delay
        setTimeout(() => { document.getElementById('modelProgress').style.display = 'none'; }, 800);
        return engine;
      } catch (err) {
        console.error('Model init failed', err);
        const errBox = document.getElementById('modelError');
        modelStatus.textContent = 'Model load failed: ' + (err && err.message ? err.message : String(err));
        if (errBox) {
          errBox.style.display = 'block';
          errBox.textContent = (err && err.stack) ? err.stack : String(err);
        }
        document.getElementById('modelProgress').style.display = 'none';
        throw err;
      }
    }

    async function interruptCurrentGeneration() {
      if (!engine || typeof engine.interruptGenerate !== 'function') return;

      try {
        await Promise.resolve(engine.interruptGenerate());
      } catch (err) {
        console.warn('Failed to interrupt previous generation', err);
      }
    }

    async function runGeneration({ generationId, text, assistantBubble, assistantItem }) {
      await ensureEngine();
      currentGenerationId = generationId;

      // Build messages array (system + conversation history + last user)
      const today = new Date().toISOString().split('T')[0];
      const messages = [
        { 
          role: 'system', 
          content: `Role & Tone:
You are a helpful, informative assistant designed to introduce visitors to Adrien Bouchet, a Software Engineer and AI Researcher. Your tone is professional, clear, and slightly conversational, with a touch of warmth to reflect Adrien’s personality. You answer questions accurately, concisely, and with a hint of curiosity, as if you’re a well-informed friend or colleague sharing insights about him.

Core Identity (About Adrien):


Who Adrien is:

A Software Engineer and AI Researcher specializing in machine learning, scalable systems, and algorithmic optimization.
Proficient in C++, Python, Java, and SQL, with deep expertise in algorithms, data structures, and operational research.
Educated in Computer Science and Applied Mathematics at leading European universities, with professional fluency in French, German, and English.


What drives Adrien:

A passion for solving complex problems through intelligent systems, data-driven approaches, and innovative software solutions.
Strong interest in explainable AI, causality, and the ethical implications of machine learning.
Enjoys mentoring, collaborating on open-source projects, and staying ahead of technological trends.


Personality traits:

Analytical and pragmatic: Loves diving into technical details but always keeps the bigger picture in mind.
Collaborative and agile: Thrives in team environments and believes in iterative, feedback-driven development.
Curious and playful: Enjoys exploring new ideas, whether through side projects, research papers, or experimenting with cutting-edge tech.


How to Answer Questions:

1. About Adrien’s Career:

If asked about his experience:

"Adrien has worked on a variety of projects, from developing machine learning models for forecasting systems to leading agile teams in fast-paced environments. His work often bridges the gap between research and real-world applications, with a focus on scalability and impact."

If asked about his skills:

"Adrien is most comfortable with C++ and Python, especially for high-performance computing or AI experiments. He also has experience with Java, SQL, and distributed systems, and he’s always eager to learn new tools that fit the problem at hand."


2. About Adrien’s Goals:

If asked about his short-term goals:

"Right now, Adrien is focused on deepening his expertise in AI and scalable systems while exploring opportunities where he can contribute to high-impact, innovative projects."

If asked about his long-term goals:

"Long-term, Adrien aims to be at the forefront of AI-driven innovation, whether through leading teams, contributing to open-source projects, or working on ethically responsible AI solutions that have a meaningful impact on society. He has various interests such as finance or ML research"


3. About Adrien’s Personality:

If asked about his work style:

"Adrien is a collaborative problem-solver—he enjoys working with others to tackle complex challenges and believes in agile methodologies to iterate quickly and effectively."

If asked about his hobbies or interests outside of work:

"Outside of coding, Adrien is a lifelong learner. He loves reading about new technologies, experimenting with side projects, or diving into the latest advancements in AI. He’s also multilingual (French, German, English) and enjoys traveling, which often sparks new ideas for his work."


4. About the Website/Chatbot:

If asked about the chatbot itself:

"This chatbot is here to help you get to know Adrien a little better! It’s designed to answer questions about his career, skills, goals, and personality—think of it as a fun, low-pressure way to start a conversation."

If the chatbot doesn’t understand a question:

"That’s an interesting question! This chatbot is still learning, so it’s best at answering questions about Adrien’s background, skills, or goals. Try asking something like, ‘What kind of projects has Adrien worked on?’ or ‘What are his long-term aspirations?’"


5. Handling Edge Cases:

If asked something too personal or unrelated:

"This chatbot is focused on sharing Adrien’s professional journey and interests. If you’d like to connect with him directly, feel free to reach out!"

If the user is a recruiter or potential employer:

"If you’re here because you’re interested in working with Adrien, he’d love to chat! You can ask about his experience, what he’s looking for in his next role, or how he might contribute to your team."


Final Notes for the Chatbot:

Stay informative and neutral: Always present Adrien’s information objectively and accurately, as if you’re a well-informed assistant.
Encourage engagement: End answers with open-ended questions or invitations when appropriate (e.g., "Would you like to know more about his work in AI?").
Be humble but confident: Acknowledge the chatbot’s limitations (e.g., "I’m still learning how to answer all kinds of questions, but I can tell you all about Adrien’s career!") while keeping the focus on Adrien’s strengths.
Be concise: Answers should be 1-2 sentences max.
Stay neutral but warm: Present facts clearly and efficiently, with a hint of personality (e.g., "He’s as passionate about algorithms as he is about cycling the Côte d’Azur.").
Encourage engagement: End with open-ended prompts (e.g., "Want to know more about his AI work or music?").



Response Rules:
- ALWAYS use third person: "Adrien is...", "He has...", "His work includes..."
- NEVER use first person: no "I", "me", "my"
- Provide direct, factual answers
- For date questions: the current date is ${today}, just state it directly
- Keep responses professional and concise (2-4 sentences)`
        },
        ...conversationHistory.slice(-MAX_HISTORY),
        { role: 'user', content: text }
      ];

      const stream = await engine.chat.completions.create({
        messages,
        stream: true,
        max_tokens: 256
      });
      let output = '';

      for await (const chunk of stream) {
        const isCurrentGeneration = generationId === activeGenerationId;
        const choice = chunk.choices?.[0];

        if (choice?.finish_reason) {
          continue;
        }

        const delta = choice?.delta?.content || '';
        if (!isCurrentGeneration || !delta) {
          continue;
        }

        output += delta;
        assistantBubble.textContent = output;
        log.scrollTop = log.scrollHeight;
      }
      
      // Add to conversation history and clean up UI
      if (generationId === activeGenerationId && output) {
        conversationHistory.push({ role: 'user', content: text });
        conversationHistory.push({ role: 'assistant', content: output });
        assistantItem.classList.remove('loading');
      }
    }

    async function processGenerationQueue() {
      if (isProcessingGeneration) return;

      isProcessingGeneration = true;
      try {
        while (pendingGeneration) {
          const generation = pendingGeneration;
          pendingGeneration = null;

          try {
            await runGeneration(generation);
          } catch (err) {
            if (generation.generationId === activeGenerationId) {
              generation.assistantBubble.textContent = 'Error: failed to get response.';
            }
            console.error(err);
          } finally {
            if (currentGenerationId === generation.generationId) {
              currentGenerationId = null;
            }
          }
        }
      } finally {
        isProcessingGeneration = false;
        if (pendingGeneration) {
          processGenerationQueue();
        }
      }
    }

    // Pre-init on page load so progress is visible immediately
    (async () => {
      // Show loading overlay
      loadingOverlay.style.visibility = 'visible';
      loadingOverlay.style.opacity = '1';
      
      if (!('gpu' in navigator)) {
        modelStatus.textContent = 'WebGPU not available; attempting fallback.';
      }
      try {
        await ensureEngine();
      } catch (e) {
        // leave status as failure message
      }
    })();

    // Clear chat button handler
    const clearChatBtn = document.getElementById('clearChatBtn');
    clearChatBtn.addEventListener('click', () => {
      if (confirm('Are you sure you want to clear the conversation?')) {
        conversationHistory = [];
        log.innerHTML = '';
        input.focus();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      activeGenerationId += 1;
      const generationId = activeGenerationId;

      addMessage('user', text);
      input.value = '';
      input.focus();

      const assistantItem = document.createElement('div');
      assistantItem.className = 'chat-message assistant loading';
      const assistantBubble = document.createElement('div');
      assistantBubble.className = 'chat-bubble';
      assistantBubble.textContent = '';
      assistantItem.appendChild(assistantBubble);
      log.appendChild(assistantItem);
      log.scrollTop = log.scrollHeight;

      pendingGeneration = { generationId, text, assistantBubble, assistantItem };

      if (currentGenerationId !== null) {
        interruptCurrentGeneration();
      }

      processGenerationQueue();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        }
      }
    });
  </script>

  <style is:global>
    .loading-overlay {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      visibility: visible;
      opacity: 1;
      transition: background-color 0.3s ease;
    }

    .loading-content {
      text-align: center;
      color: #fff;
    }

    .loading-text {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      font-weight: 500;
    }

    .loading-percent {
      font-size: 2rem;
      font-weight: 700;
    }

    #chatPanel {
      transition: opacity 0.5s ease-out, visibility 0.5s ease-out;
    }

    .chat-page {
      height: 100dvh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 7rem 1.5rem 2rem;
    }

    .chat-panel {
      width: min(48rem, 100%);
      height: calc(100dvh - 9rem);
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .chat-log {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      width: 100%;
      max-width: 42rem;
      margin: 0 auto;
    }

    .chat-form {
      flex-shrink: 0;
      margin-top: 1rem;
    }

    .clear-chat-btn {
      align-self: flex-end;
      margin-bottom: 0.5rem;
      padding: 0.4rem 0.8rem;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.5rem;
      color: rgba(255, 255, 255, 0.8);
      font: inherit;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
      backdrop-filter: blur(10px);
    }

    .clear-chat-btn:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.3);
      color: #fff;
    }

    .clear-chat-btn:active {
      background: rgba(255, 255, 255, 0.08);
      transform: scale(0.98);
    }

    .chat-log::-webkit-scrollbar {
      width: 0;
    }

    .chat-log::-webkit-scrollbar-thumb {
      background: transparent;
      border-radius: 999px;
      transition: background .2s;
    }

    .chat-log:hover::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,.25);
    }


    .chat-message {
      display: flex;
      width: 100%;
      padding: 0;
      margin: 0.75rem 0;
    }

    .chat-message.assistant {
      justify-content: flex-start;
    }

    .chat-message.assistant .chat-bubble {
      margin-right: auto;
    }

    .chat-message.user {
      justify-content: flex-end;
    }

    .chat-message.user .chat-bubble {
      margin-left: auto;
    }

    .chat-bubble {
      width: fit-content;
      max-width: 78%;
      padding: 1rem 1.2rem;
      border-radius: 1.8rem;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 0.95rem;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
    }

    .chat-message.assistant .chat-bubble {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border-bottom-left-radius: 0.45rem;
    }

    .chat-message.user .chat-bubble {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border-bottom-right-radius: 0.45rem;
      text-align: left;
      border-color: rgba(255, 255, 255, 0.1);
    }

    .chat-form {
      position: sticky;
      bottom: 0;
    }

    .chat-form textarea {
      width: 100%;
      min-height: 4.5rem;
      resize: vertical;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 1rem;
      padding: 1rem 1.1rem;
      font: inherit;
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      margin-bottom: 1rem;
    }

    .chat-form textarea::placeholder {
      color: #ccc;
      opacity: 1;
    }

    .chat-form textarea:focus {
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }

    @media (max-width: 720px) {
      .chat-page {
        padding: 5.5rem 1rem 1.5rem;
      }

      .chat-panel {
        padding: 1.25rem;
      }

      .chat-bubble {
        max-width: 100%;
      }
    }
  </style>
</Layout>
