---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Chat">
  <section class="chat-page" aria-label="Chat interface">
    <div class="chat-panel">
      <div class="chat-log" id="chatLog" aria-live="polite"></div>

      <form class="chat-form" id="chatForm">
        <label for="chatInput" class="sr-only">Message</label>
        <textarea
          id="chatInput"
          name="message"
          rows="2"
          placeholder="Write a message..."
          required
        ></textarea>
      </form>
    </div>
  </section>

  <script type="module">
    const form = document.getElementById('chatForm');
    const input = document.getElementById('chatInput');
    const log = document.getElementById('chatLog');

    function addMessage(role, text) {
      const item = document.createElement('div');
      item.className = `chat-message ${role}`;
      item.innerHTML = `<div class="chat-bubble">${text}</div>`;
      log.appendChild(item);
      log.scrollTop = log.scrollHeight;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      addMessage('user', text);
      input.value = '';
      input.focus();

      const placeholder = document.createElement('div');
      placeholder.className = 'chat-message assistant loading';
      placeholder.innerHTML = `<div class="chat-bubble">Assistant will reply here.</div>`;
      log.appendChild(placeholder);
      log.scrollTop = log.scrollHeight;
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
  </script>

  <style>
    .chat-page {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 7rem 1.5rem 2rem;
    }

    .chat-panel {
      width: min(48rem, 100%);
      max-width: 48rem;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 1.5rem;
      backdrop-filter: blur(18px);
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .chat-log {
      min-height: 28rem;
      max-height: 54rem;
      overflow-y: auto;
      padding: 1rem;
      margin-bottom: 1.2rem;
      border-radius: 1.25rem;
      background: transparent;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .chat-message {
      display: flex;
      justify-content: flex-start;
      padding: 0;
    }

    .chat-message.user {
      justify-content: flex-end;
    }

    .chat-bubble {
      max-width: 78%;
      padding: 1rem 1.2rem;
      border-radius: 1.8rem;
      background: rgba(255, 255, 255, 0.95);
      color: #0a0a0a;
      font-size: 0.95rem;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
    }

    .chat-message.assistant .chat-bubble {
      background: rgba(255, 255, 255, 0.9);
      color: #0a0a0a;
    }

    .chat-form {
      display: grid;
      gap: 0.75rem;
    }

    .chat-form textarea {
      width: 100%;
      min-height: 4.5rem;
      resize: vertical;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 1rem;
      padding: 1rem 1.1rem;
      font: inherit;
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .chat-form textarea:focus {
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }

    @media (max-width: 720px) {
      .chat-page {
        padding: 5.5rem 1rem 1.5rem;
      }

      .chat-panel {
        padding: 1.25rem;
      }

      .chat-bubble {
        max-width: 100%;
      }
    }
  </style>
</Layout>
